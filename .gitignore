# Python and tooling
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.hypothesis/
.coverage
.DS_Store

# Secrets
.env
.env.*
*.pem
*.key
*.p12

